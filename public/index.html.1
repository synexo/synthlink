<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SynthLink — modem-carried web BBS terminal</title>
<style>
  :root { --amber:#ffb000; --green:#33ff66; --dim:#7a7a7a; --panel:#141414; }
  * { box-sizing: border-box; }
  html,body { margin:0; height:100%; background:#0a0a0a; color:#cfcfcf;
    font-family: ui-monospace, "DejaVu Sans Mono", Menlo, Consolas, monospace; }
  body { display:flex; flex-direction:column; height:100%; }

  /* Status bar — controls on the left (grouped, wrapping compactly), the scope
     filling the right and staying vertically centered. Grows in height rather
     than clipping. The bar itself does NOT wrap, so the scope never breaks onto
     its own line at intermediate widths — that only happens at the mobile
     breakpoint below, where the whole bar switches to a vertical stack. */
  #bar { display:flex; align-items:flex-start; gap:1rem;
    padding:.6rem .9rem; background:var(--panel); border-bottom:1px solid #262626;
    min-height:104px; flex:0 0 auto; }
  #controls { display:flex; flex-direction:column; justify-content:center; gap:.45rem;
    flex:1 1 auto; min-width:0; }
  .row { display:flex; align-items:center; gap:.4rem .6rem; flex-wrap:wrap; }
  /* Each label+control stays glued together and wraps as one unit. */
  .grp { display:inline-flex; align-items:center; gap:.35rem; min-width:0; }
  .grp.btns { gap:.5rem; flex-wrap:wrap; }
  #bar label { color:var(--dim); font-size:.78rem; flex:0 0 auto; }
  #bar input, #bar select { background:#000; color:var(--green); border:1px solid #333;
    padding:.32rem .45rem; font:inherit; min-width:0; }
  #bbs { flex:1 1 12rem; min-width:7rem; }
  #protocol { flex:0 1 auto; }
  #listen { min-width:6.6rem; text-align:left; }
  #listen .spk { display:inline-block; width:1.1em; }
  #host { flex:0 1 auto; width:calc(16ch + 1rem); min-width:0; }
  #port { flex:0 0 auto; width:calc(5ch + 1rem); }
  button { background:#1d1d1d; color:#e0e0e0; border:1px solid #3a3a3a;
    padding:.36rem .75rem; font:inherit; cursor:pointer; border-radius:3px; }
  button:hover:not(:disabled) { border-color:var(--amber); color:var(--amber); }
  button:disabled { opacity:.4; cursor:default; }
  button.on { border-color:var(--green); color:var(--green); }
  #led { width:.72rem; height:.72rem; border-radius:50%; background:#500;
    box-shadow:0 0 4px #300; transition:all .2s; flex:0 0 auto; }
  #led.neg { background:var(--amber); box-shadow:0 0 8px var(--amber); animation:pulse .8s infinite; }
  #led.up  { background:var(--green); box-shadow:0 0 8px var(--green); animation:none; }
  @keyframes pulse { 50% { opacity:.35; } }
  #status { color:var(--dim); font-size:.8rem; white-space:nowrap; overflow:hidden;
    text-overflow:ellipsis; }

  /* Oscilloscope (3:1). Shrinkable, and drops onto its own row when the
     controls need the width; only then does it scale down. */
  /* The scope sits at the top-right; controls grow to fill the space to its left
     (so the gutters match the bar's left/right padding). Its size is driven purely
     by viewport width — clamp() for the width, 3:1 aspect for the height — so it's
     stable and predictable on load and on every resize, with no dependence on the
     (variable) control-column height. */
  #scope-wrap { flex:0 0 auto; display:flex; align-items:flex-start; }
  #scope { width:clamp(200px, 20vw, 320px); aspect-ratio:3 / 1; height:auto;
    background:#000; border:1px solid #234a2e; border-radius:3px;
    box-shadow:0 0 10px #06220f inset; }

  /* Narrow / portrait: stack the header vertically, give the scope a full-width
     row of its own, and let it scale down to keep everything on-screen. */
  @media (max-width: 640px) {
    #bar { flex-direction:column; align-items:stretch; gap:.55rem; min-height:0; }
    #controls { flex:0 0 auto; }
    #scope-wrap { flex:0 0 auto; width:100%; }
    #scope { width:100%; height:60px; aspect-ratio:auto; }
  }

  /* Short viewports (landscape phones, small windows): the fixed full-height
     layout would squeeze the terminal to nothing, so let the page scroll and
     give the terminal a real, usable height instead. */
  @media (max-height: 600px) {
    html, body { height:auto; }
    body { min-height:100%; overflow-y:auto; }
    #wrap { flex:0 0 auto; height:75vh; min-height:280px; }
  }

  /* Terminal fills remaining window */
  #wrap { flex:1 1 auto; display:flex; justify-content:center; align-items:center;
    overflow:hidden; padding:0; min-height:0; position:relative; }

  /* Scrollback position indicator, shown briefly while reviewing history. */
  #scrollback-indicator { position:absolute; top:10px; right:14px;
    background:rgba(0,0,0,0.8); border:1px solid var(--green); color:var(--green);
    font:11px ui-monospace, "DejaVu Sans Mono", monospace; letter-spacing:.06em;
    padding:3px 8px; border-radius:3px; opacity:0; pointer-events:none;
    transition:opacity .2s; z-index:5; }
  #scrollback-indicator.visible { opacity:1; }

  /* Transient toast — doubles as the touch-device tooltip (title only shows on hover). */
  #toast { position:absolute; left:50%; bottom:14px; transform:translateX(-50%);
    background:rgba(0,0,0,0.82); border:1px solid var(--green); color:var(--green);
    font:12px ui-monospace,"DejaVu Sans Mono",monospace; letter-spacing:.04em;
    padding:5px 12px; border-radius:4px; opacity:0; pointer-events:none;
    transition:opacity .18s; z-index:6; white-space:nowrap; }
  #toast.show { opacity:1; }
  #scrolltoggle .kbdicon { font-size:1.05rem; line-height:1; }
  #terminal-canvas { background:#000; image-rendering:pixelated;
    box-shadow:0 0 0 1px #333, 0 0 40px #000 inset; }

  /* ── On-screen keyboard ─────────────────────────────────────────── */
  #kbdtoggle .kbdicon { font-size:1.15rem; line-height:1; }
  #keyboard { flex:0 0 auto; background:var(--panel); border-top:1px solid #262626;
    padding:6px; display:flex; flex-direction:column; gap:5px; user-select:none;
    -webkit-user-select:none; touch-action:manipulation;
    width:100%; align-self:center; margin:0 auto; }   /* max-width set in JS = terminal width */
  #keyboard[hidden] { display:none; }

  /* Mobile + keyboard open: let the whole page scroll so the full-size terminal
     and the keyboard are both reachable, instead of squashing the terminal. */
  @media (max-width: 640px) {
    body.kbd-open { display:block; height:auto; min-height:100%; overflow-y:auto; }
    body.kbd-open #wrap { display:block; height:auto; }
  }
  #keyboard .krow { display:flex; gap:5px; }
  #keyboard .pads { display:flex; gap:14px; justify-content:center; align-items:flex-start; }
  #keyboard .pad { display:grid; gap:5px; }
  #keyboard .pad.num { grid-template-columns:repeat(4, minmax(0,64px)); }
  #keyboard .pad.nav { grid-template-columns:repeat(3, minmax(0,64px)); }
  #keyboard .foot { display:flex; gap:5px; justify-content:center; }
  #keyboard .foot .kbk { max-width:120px; }
  #keyboard .kbk { flex:1 1 0; min-width:0; height:clamp(34px, 6.2vh, 52px);
    display:flex; align-items:center; justify-content:center;
    background:#1d1d1d; color:#e0e0e0; border:1px solid #3a3a3a; border-radius:5px;
    font: inherit; font-size:.95rem; cursor:pointer; padding:0; }
  #keyboard .kbk:active { background:#2b2b2b; border-color:var(--amber); }
  #keyboard .kbk small { font-size:.55rem; color:var(--dim); margin-left:3px; }
  #keyboard .kbk.acc { border-color:var(--green); color:var(--green); }
  #keyboard .kbk.mod { border-color:var(--amber); color:var(--amber); }
  #keyboard .kbk.fn  { color:#9fd0ff; border-color:#31506a; }
  #keyboard .kbk.blank { visibility:hidden; cursor:default; }
  #keyboard .pad .kbk { flex:none; }
</style>
</head>
<body>
  <div id="bar">
    <div id="controls">
      <div class="row">
        <span class="grp"><label>BBS</label>
        <select id="bbs" title="BBS directory (config/bbs.json)"></select></span>
        <span class="grp"><label>host</label>
        <input id="host" value="bbs.birdenuf.com" spellcheck="false" autocomplete="off"></span>
        <span class="grp"><label>port</label>
        <input id="port" value="2003" spellcheck="false" autocomplete="off"></span>
        <span class="grp"><label>speed</label>
        <select id="protocol" title="Modem protocol">
          <option value="V21">V.21 &middot; 300 bps</option>
          <option value="Bell103">Bell 103 &middot; 300 bps</option>
          <option value="V22">V.22 &middot; 1200 bps</option>
          <option value="V22bis" selected>V.22bis &middot; 2400 bps</option>
          <option value="V23">V.23 &middot; 1200/75</option>
          <option value="V29">V.29 &middot; 9600 bps</option>
          <option value="V32">V.32 &middot; 9600 bps</option>
          <option value="V32bis">V.32bis &middot; 14400 bps</option>
          <option value="V34@28800">V.34 &middot; 28800 bps</option>
          <option value="V34@31200">V.34 &middot; 31200 bps</option>
          <option value="V34@33600">V.34 &middot; 33600 bps</option>
        </select></span>
        <span class="grp btns">
          <button id="dial">Connect</button>
          <button id="extension" disabled title="Pick up an extension phone on the line — injects room audio into the call, disrupting the carrier">Handset</button>
          <button id="scrolltoggle" title="Scrollback — enable/disable reviewing terminal history (mouse wheel, swipe, Page keys)"><span class="kbdicon">&#128220;</span></button>
          <button id="kbdtoggle" title="Show / hide the on-screen keyboard"><span class="kbdicon">&#9000;</span></button>
          <button id="listen" class="on" title="Speaker: Auto (play through the dial + handshake, then fade) / Listen (always on) / Mute (always off)"><span class="spk">&#128266;</span> <span class="lbl">Auto</span></button>
          <span id="led" title="carrier"></span>
        </span>
      </div>
      <div class="row"><span id="status">idle</span></div>
    </div>
    <div id="scope-wrap"><canvas id="scope"></canvas></div>
  </div>

  <div id="wrap">
    <canvas id="terminal-canvas" tabindex="0"></canvas>
    <div id="scrollback-indicator"></div>
    <div id="toast"></div>
  </div>

  <!-- On-screen keyboard (mostly for mobile). Built by main.js; hidden by default. -->
  <div id="keyboard" hidden></div>

  <script src="dsp-bundle.js"></script>
  <script type="module" src="main.js"></script>
</body>
</html>
