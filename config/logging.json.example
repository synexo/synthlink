{
  "_comment": [
    "SynthLink logging. Edit and restart. No environment variables — this file is",
    "the whole configuration.",
    "",
    "  dir              where the daily logs are written. Relative paths are from",
    "                   the repo root; an absolute path (e.g. /var/log/synthlink)",
    "                   works too.",
    "  level            console verbosity: error | warn | info. Files always get",
    "                   everything; this only filters what is echoed live.",
    "  debug            per-chunk transfer logging (a line per buffer, both",
    "                   directions). Extremely verbose — for chasing a stall, not",
    "                   for normal running.",
    "  retentionDays    daily files older than this are deleted. 0 = keep forever.",
    "  console          aggregate | off. 'aggregate' echoes all three log streams",
    "                   live to stdout.",
    "  trustProxy       honour CF-Connecting-IP / X-Forwarded-For. Turn OFF if the",
    "                   server is reachable directly, or clients can forge the IP",
    "                   that lands in the access log.",
    "  trustedProxies   which peers may speak for someone else. [] = trust any",
    "                   peer (correct when only the proxy can reach this box).",
    "                   Entries are addresses or CIDR blocks, v4 or v6, e.g.",
    "                   \"173.245.48.0/20\" or \"2400:cb00::/32\" — Cloudflare",
    "                   publishes ranges, not addresses. An unparseable entry is",
    "                   named on stderr and ignored, and a list where NOTHING",
    "                   parses trusts nobody, so a typo can only tighten this.",
    "                   NOT access control: this decides which headers are",
    "                   believed, never who may connect. Nothing is refused.",
    "                   SHIPPED POPULATED with Cloudflare's published ranges",
    "                   (cloudflare.com/ips-v4 and /ips-v6). An empty list means",
    "                   trust ANY peer, which is only correct while nothing but",
    "                   the proxy can reach this box — a leaked origin address or",
    "                   an uncovered IPv6 route then lets any client forge the IP",
    "                   in the access log. Refresh these when Cloudflare",
    "                   publishes a change; if you are NOT behind Cloudflare, set",
    "                   trustProxy false instead of emptying this.",
    "  trackBytes       per-session byte totals for telnet payload and modem audio.",
    "                   Four integer adds per buffer; the cost is not measurable.",    "",
    "  connectTimeoutMs HAS MOVED to config/site.json, where the rest of the",
    "                   call behaviour lives. A value left here is ignored, and",
    "                   said so on stderr at boot."
  ],

  "dir": "logs",
  "level": "info",
  "debug": false,
  "retentionDays": 30,
  "console": "aggregate",
  "trustProxy": true,
  "trustedProxies": [
    "173.245.48.0/20",
    "103.21.244.0/22",
    "103.22.200.0/22",
    "103.31.4.0/22",
    "141.101.64.0/18",
    "108.162.192.0/18",
    "190.93.240.0/20",
    "188.114.96.0/20",
    "197.234.240.0/22",
    "198.41.128.0/17",
    "162.158.0.0/15",
    "104.16.0.0/13",
    "104.24.0.0/14",
    "172.64.0.0/13",
    "131.0.72.0/22",
    "2400:cb00::/32",
    "2606:4700::/32",
    "2803:f800::/32",
    "2405:b500::/32",
    "2405:8100::/32",
    "2a06:98c0::/29",
    "2c0f:f248::/32"
  ],
  "trackBytes": true
}
